rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // User cannot grant themselves admin privileges.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student';
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }
    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /attendance/{attendanceId} {
      allow read: if signedIn() &&
        (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'hadir'
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.active == true
        && request.resource.data.keys().hasOnly(['studentId','studentName','nim','sessionId','sessionTitle','createdAt','status']);
      allow update, delete: if isAdmin();
    }
  }
}